          {reviewRows.length ? (
            <ul className="mt-5 flex flex-col gap-3">
              {reviewRows.map((review) => {
                const username = getUsername(review.profiles);
                const reviewDate = formatReviewDate(review.created_at);

                return (
                  <li
                    key={review.id}
